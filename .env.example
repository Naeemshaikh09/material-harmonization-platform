# Database Configuration (Supabase / PostgreSQL)
# Option A: Supabase Connection String (Direct or Pooler)
# Format: postgresql://postgres.[project_ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Option B: Standard Database URL
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase API Credentials (Optional for client integrations)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PostgreSQL Connection Details (Individual parameters)
POSTGRES_USER=postgres.your_project_ref
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=aws-0-ap-south-1.pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_DB=postgres

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change_this_to_random_secret_key_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ML Service
ML_SERVICE_URL=http://localhost:8001
ML_MODEL_PATH=./ml/models/extraction_model.pth
ML_MODEL_VERSION=v1

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENV=development

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Security
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ENABLED=true

# Data Paths
DICTIONARIES_PATH=./data/dictionaries
TEMPLATES_PATH=./data/templates
CODE_TABLES_PATH=./data/code_tables

# Development
DEBUG=true
RELOAD=true
