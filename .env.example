# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/material_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=material_platform

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change_this_to_random_secret_key_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ML Service
ML_SERVICE_URL=http://localhost:8001
ML_MODEL_PATH=./ml/models/extraction_model.pth
ML_MODEL_VERSION=v1

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENV=development

# AWS (if using S3 for ML models)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=ap-south-1
# S3_BUCKET=material-platform-models

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Security
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ENABLED=true

# Data Paths
DICTIONARIES_PATH=./data/dictionaries
TEMPLATES_PATH=./data/templates
CODE_TABLES_PATH=./data/code_tables

# Development
DEBUG=true
RELOAD=true

# NEVER commit the actual .env file!
# Copy this to .env and fill in real values
